{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://boom-hud.dev/schemas/runtime-node-graph.schema.json",
  "title": "RuntimeNodeGraphSnapshot",
  "description": "BoomHud nodeGraph dataModel.graph payload consumed by runtime-surface renderers.",
  "type": "object",
  "required": ["status", "title", "revision", "nodes", "wires"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "status": { "type": "string" },
    "title": { "type": "string" },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/runtimeNodeGraphNode" }
    },
    "wires": {
      "type": "array",
      "items": { "$ref": "#/$defs/runtimeNodeGraphWire" }
    },
    "metadata": {
      "$ref": "#/$defs/jsonObject"
    }
  },
  "$defs": {
    "jsonNode": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/jsonNode" }
        },
        { "$ref": "#/$defs/jsonObject" }
      ]
    },
    "jsonObject": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/jsonNode" }
    },
    "runtimeNodeGraphNode": {
      "type": "object",
      "required": [
        "nodeId",
        "label",
        "typeId",
        "category",
        "summary",
        "detail",
        "isSideEffect",
        "isExpensive",
        "inputCount",
        "outputCount",
        "inputs",
        "outputs"
      ],
      "additionalProperties": false,
      "properties": {
        "nodeId": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "typeId": { "type": "string" },
        "category": { "type": "string" },
        "summary": { "type": "string" },
        "detail": { "type": "string" },
        "isSideEffect": { "type": "boolean" },
        "isExpensive": { "type": "boolean" },
        "inputCount": { "type": "integer", "minimum": 0 },
        "outputCount": { "type": "integer", "minimum": 0 },
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/runtimeNodeGraphPort" }
        },
        "outputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/runtimeNodeGraphPort" }
        },
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/$defs/runtimeNodeGraphParameter" }
        },
        "parameterLines": {
          "type": "array",
          "items": { "type": "string" }
        },
        "metadata": {
          "$ref": "#/$defs/jsonObject"
        }
      }
    },
    "runtimeNodeGraphPort": {
      "type": "object",
      "required": ["portId", "label", "kindHint", "required"],
      "additionalProperties": false,
      "properties": {
        "portId": { "type": "string" },
        "label": { "type": "string" },
        "kindHint": { "type": "string" },
        "required": { "type": "boolean" }
      }
    },
    "runtimeNodeGraphParameter": {
      "type": "object",
      "required": ["key", "label", "value", "kindHint"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string" },
        "label": { "type": "string" },
        "value": { "$ref": "#/$defs/jsonNode" },
        "kindHint": { "type": "string" }
      }
    },
    "runtimeNodeGraphWire": {
      "type": "object",
      "required": ["fromNodeId", "toNodeId", "kindHint"],
      "additionalProperties": false,
      "properties": {
        "fromNodeId": { "type": "string", "minLength": 1 },
        "fromSlot": { "type": "integer", "minimum": 0 },
        "fromPortId": { "type": "string" },
        "toNodeId": { "type": "string", "minLength": 1 },
        "toSlot": { "type": "integer", "minimum": 0 },
        "toPortId": { "type": "string" },
        "kindHint": { "type": "string" }
      }
    }
  }
}
