<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework></TargetFramework>
    <!-- netstandard2.1 added so Unity (its scripting runtime) can consume the runtime-surface
         contracts (BoomHud.Abstractions.Runtime) via NuGetForUnity. -->
    <TargetFrameworks>net8.0;net9.0;netstandard2.1</TargetFrameworks>
    <AssemblyName>BoomHud.Abstractions</AssemblyName>
    <RootNamespace>BoomHud.Abstractions</RootNamespace>
    <PackageId>BoomHud.Foundation</PackageId>
    <Description>Foundation contracts, IR, diagnostics, composition, and token models for BoomHud</Description>
    <PackageTags>ui;code-generation;foundation;ir;composition;tokens;boomhud</PackageTags>
    <!-- Relax perf/style analyzers that demand net-core-only overloads (char StartsWith/EndsWith,
         ArgumentNullException.ThrowIfNull, Replace(StringComparison), …) we cannot use on the
         shared netstandard2.1 source. The net8/9 builds keep TreatWarningsAsErrors. -->
    <NoWarn>$(NoWarn);CA1510;CA1865;CA1866;CA1867;CA1307;CA1310;CA1846;CA1861;CA1863;CA1869</NoWarn>
  </PropertyGroup>

  <!-- System.Text.Json is in-box on net8/9; on netstandard2.1 it comes from the package (already
       present in the Unity host via NuGetForUnity at the same 8.0.5 version). -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <!-- Enable DisposePattern source generator via local props (targets plate-shared set) -->
  <Import Project="..\..\source-generators\DisposePattern.BoomHud.props"
          Condition="'$(BoomHud_EnableDisposePattern)' == 'true'" />

</Project>
